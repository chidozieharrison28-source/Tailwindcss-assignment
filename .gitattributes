# Normalize line endings
* text=auto

# Source files
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Images
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary

# Hide lockfile diffs
package-lock.json -diff